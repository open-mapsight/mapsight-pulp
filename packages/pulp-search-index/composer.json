{
    "name": "mapsight/pulp-search-index",
    "description": "Search index of GeoJSON features for Pulp pipelines: build it, store it in a database, and search it.",
    "type": "library",
    "keywords": [
        "mapsight",
        "pulp",
        "search",
        "geojson"
    ],
    "homepage": "https://github.com/open-mapsight/mapsight-pulp",
    "license": "MIT",
    "authors": [
        {
            "name": "Paul Golmann",
            "email": "mail@pje-web.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/open-mapsight/mapsight-pulp/issues",
        "source": "https://github.com/open-mapsight/mapsight-pulp/tree/main/packages/pulp-search-index"
    },
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "mapsight/pulp": "*",
        "mapsight/pulp-pdo": "*"
    },
    "autoload": {
        "classmap": [
            "PulpSearchIndex.php"
        ],
        "psr-4": {
            "OpenMapsight\\pulpsearchindex\\": "src"
        }
    },
    "archive": {
        "exclude": [
            "*",
            ".*",
            "!/src/*",
            "!/PulpSearchIndex.php",
            "!/README.md",
            "!/CHANGELOG.md"
        ]
    }
}
