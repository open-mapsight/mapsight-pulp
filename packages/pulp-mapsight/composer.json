{
    "name": "mapsight/pulp-mapsight",
    "description": "Mapsight helpers for Pulp pipelines: read the feature sources of Mapsight pages.",
    "type": "library",
    "keywords": [
        "mapsight",
        "pulp",
        "geojson",
        "feature-sources"
    ],
    "homepage": "https://github.com/open-mapsight/mapsight-pulp",
    "license": "MIT",
    "authors": [
        {
            "name": "Paul Golmann",
            "email": "mail@pje-web.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/open-mapsight/mapsight-pulp/issues",
        "source": "https://github.com/open-mapsight/mapsight-pulp/tree/main/packages/pulp-mapsight"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "mapsight/pulp": "*"
    },
    "autoload": {
        "classmap": [
            "PulpMapsight.php"
        ],
        "psr-4": {
            "OpenMapsight\\pulpmapsight\\": "src"
        }
    },
    "archive": {
        "exclude": [
            "*",
            ".*",
            "!/src/*",
            "!/PulpMapsight.php",
            "!/README.md",
            "!/CHANGELOG.md"
        ]
    }
}
