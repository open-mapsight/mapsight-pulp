{
    "name": "mapsight/pulp-ogc",
    "description": "Read OGC Web Feature Services (WFS) as GeoJSON in Pulp pipelines, with paging and completeness checks.",
    "type": "library",
    "keywords": [
        "mapsight",
        "pulp",
        "ogc",
        "wfs",
        "geojson"
    ],
    "homepage": "https://github.com/open-mapsight/mapsight-pulp",
    "license": "MIT",
    "authors": [
        {
            "name": "Paul Golmann",
            "email": "mail@pje-web.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/open-mapsight/mapsight-pulp/issues",
        "source": "https://github.com/open-mapsight/mapsight-pulp/tree/main/packages/pulp-ogc"
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "mapsight/pulp": "*"
    },
    "autoload": {
        "classmap": [
            "PulpOgc.php"
        ],
        "psr-4": {
            "OpenMapsight\\pulpogc\\": "src"
        }
    },
    "archive": {
        "exclude": [
            "*",
            ".*",
            "!/src/*",
            "!/PulpOgc.php",
            "!/README.md",
            "!/CHANGELOG.md"
        ]
    }
}
