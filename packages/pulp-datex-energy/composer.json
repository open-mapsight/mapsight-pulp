{
    "name": "mapsight/pulp-datex-energy",
    "description": "AFIR DATEX II energy-infrastructure helpers for Pulp pipelines.",
    "type": "library",
    "keywords": [
        "mapsight",
        "pulp",
        "datex",
        "afir",
        "charging",
        "energy"
    ],
    "homepage": "https://github.com/open-mapsight/mapsight-pulp",
    "license": "MIT",
    "authors": [
        {
            "name": "Paul Golmann",
            "email": "mail@pje-web.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "mapsight/pulp": "*",
        "mapsight/pulp-mobilithek": "*"
    },
    "autoload": {
        "classmap": [
            "PulpDatexEnergy.php"
        ],
        "psr-4": {
            "OpenMapsight\\pulpdatexenergy\\": "src"
        }
    },
    "archive": {
        "exclude": [
            "*",
            ".*",
            "!/src/*",
            "!/PulpDatexEnergy.php",
            "!/README.md",
            "!/CHANGELOG.md"
        ]
    }
}
